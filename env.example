# MongoDB Atlas Configuration
# Get this from your MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/spliteasy?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Logging
LOG_LEVEL=info

# Node Environment
NODE_ENV=production

# Port Configuration
PORT=3001 

# CORS Configuration
# Comma-separated list of allowed origins for browser clients
CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com 

REACT